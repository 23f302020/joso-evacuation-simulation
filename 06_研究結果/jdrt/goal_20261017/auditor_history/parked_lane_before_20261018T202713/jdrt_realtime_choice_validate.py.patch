+def lane_allowed(attributes, mode):
+    allowed, denied = attributes.get('allow', '').split(), attributes.get('disallow', '').split()
+    return (not allowed or mode in allowed or 'all' in allowed) and mode not in denied and 'all' not in denied
+
+
+def vehicle_source_contract(event, actor, lanes, route, stop_position, route_index=None):
+    """Derive source identity from raw actor/stop getters and the native net."""
+    raw, stop = event.get('native_source', {}), event.get('native_parking_stop')
+    reference = event.get('source_reference_lane_id')
+    if not actor or reference not in lanes or not raw:
+        return False
+    edge, attributes = lanes[reference]
+    expected_index = int(actor['route_index']) if route_index is None else route_index
+    if (float(actor['time_sec']) != event['time_sec'] or raw.get('route') != route
+            or raw.get('route_index') != expected_index
+            or not 0 <= raw['route_index'] < len(route) or route[raw['route_index']] != edge
+            or event['source_lane_id'] != actor['lane_id']
+            or raw.get('lane_id') != actor['lane_id'] or raw.get('road_id') != actor['road_id']
+            or raw.get('stop_state') != int(actor['stop_state']) or edge != actor['road_id']
+            or not lane_allowed(attributes, 'passenger')):
+        return False
+    for key in ('lane_position_m', 'speed_mps', 'decel_mps2'):
+        if key not in raw or not math.isfinite(raw[key]) or not math.isclose(raw[key], float(actor[key]), rel_tol=0, abs_tol=1e-7):
+            return False
+    if actor['lane_id']:
+        return event.get('source_kind') == 'onroad_lane' and reference == actor['lane_id'] and stop is None
+    if (event.get('source_kind') != 'parked_stop' or not stop or int(actor['stop_state']) & 3 != 3
+            or actor['observation_kind'] != 'parked' or float(actor['speed_mps']) != 0
+            or route[-1] != edge or stop_position is None):
+        return False
+    try:
+        return (stop['lane_id'] == actor['native_stop_lane_id'] == reference
+            and stop['flags'] == int(actor['native_stop_flags']) and bool(stop['flags'] & 1)
+            and stop['start_pos_m'] == float(actor['native_stop_start_pos_m'])
+            and stop['end_pos_m'] == float(actor['native_stop_end_pos_m']) == stop_position
+            and 0 <= stop['start_pos_m'] <= float(actor['lane_position_m']) <= stop['end_pos_m'] <= float(attributes['length']))
+    except (KeyError, TypeError, ValueError):
+        return False
+
