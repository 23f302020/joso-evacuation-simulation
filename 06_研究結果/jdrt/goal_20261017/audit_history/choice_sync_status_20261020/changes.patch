+def atomic_bytes(path, raw):
+    temporary = path.with_name(path.name + '.choice_sync.tmp')
+    created = False
+    try:
+        with temporary.open('xb') as stream:
+            created = True
+            stream.write(raw)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, path)
+    finally:
+        if created and temporary.exists():
+            temporary.unlink()
